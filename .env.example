# =====================================================
# TeleTorrent Configuration Template
# Copy to /etc/teletorrent.env during installation
# =====================================================

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Telegram Local Bot API (required for 2 GB uploads)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081

# ---------- qBittorrent ----------
QBIT_HOST=http://127.0.0.1:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=

# ---------- Dashboard ----------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8787
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# ---------- Storage ----------
QUARANTINE_DIR=/srv/teletorrent/quarantine
APPROVED_DIR=/srv/teletorrent/approved
REJECTED_DIR=/srv/teletorrent/rejected

# ---------- Database ----------
DATABASE_PATH=/var/lib/teletorrent/teletorrent.db

# ---------- Scanning ----------
AUTO_APPROVE=true
SCAN_INTERVAL=10
MAX_TORRENT_MB=10

# ---------- Telegram File Delivery ----------
TELEGRAM_DIRECT_LIMIT_BYTES=1990000000
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=1800

# ---------- Temporary Download Links ----------
TEMP_LINK_DURATION_MINUTES=15
TEMP_DOWNLOAD_HOST=127.0.0.1
TEMP_DOWNLOAD_PORT=8790
